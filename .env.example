# ============================================================================
# Cấu hình môi trường cho pipeline cào tin và hỏi-đáp RAG.
#
# Sao chép file này thành `.env` rồi điều chỉnh. `.env` nằm trong .gitignore và
# không bao giờ được commit.
# ============================================================================

# ---- Phiên bản image (ghim để môi trường tái lập được) ---------------------
POSTGRES_VERSION=16
MINIO_VERSION=RELEASE.2024-08-17T01-24-54Z
MINIO_MC_VERSION=RELEASE.2024-08-17T11-33-50Z
# Image REST catalog chính thức của Apache Iceberg
ICEBERG_REST_VERSION=1.9.2
# Driver JDBC thêm vào image catalog, xem iceberg-rest/Dockerfile
POSTGRES_JDBC_VERSION=42.7.4
AIRFLOW_VERSION=2.10.2

# ---- Postgres dùng chung (metadata của Iceberg catalog và Airflow) ---------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- MinIO (object store tương thích S3) -----------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Hai bucket được tạo lúc khởi động
MINIO_WAREHOUSE_BUCKET=warehouse   # warehouse của Iceberg, chứa dữ liệu bảng
MINIO_RAW_BUCKET=raw               # HTML gốc đã nén gzip
AWS_REGION=us-east-1

# ---- Iceberg REST Catalog --------------------------------------------------
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_DB=iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg

# ---- Qdrant (vector store) -------------------------------------------------
QDRANT_VERSION=v1.12.4
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Qdrant bật xác thực ngay khi biến này tồn tại, nên không được để trống: giá
# trị rỗng đồng nghĩa với xác thực bật mà không key nào hợp lệ. Giá trị dưới
# đây chỉ dùng cho môi trường phát triển cục bộ.
QDRANT_API_KEY=qdrant-local-dev
QDRANT_COLLECTION=news_chunks

# ---- Gemini (embedding và sinh câu trả lời) --------------------------------
# Tạo key tại https://aistudio.google.com/apikey
#
# Có thể khai nhiều key, phân tách bằng dấu phẩy, để pool xoay vòng khi một key
# cạn hạn mức. Lưu ý hạn mức Gemini tính trên từng project: các key chỉ cộng dồn
# được hạn mức nếu chúng thuộc những project khác nhau.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_KEY_COOLDOWN=60
# Ngân sách token mỗi phút cho từng key. Google không công bố trần TPM theo
# model nên giá trị này suy ra từ đo đạc; sửa lại nếu hạn mức thay đổi.
# SAFETY là tỉ lệ trần thực sự tiêu, phần dư bù cho sai số của ước lượng token.
GEMINI_TPM_LIMIT=30000
GEMINI_TPM_SAFETY=0.8
GEMINI_RPM_LIMIT=100
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-latest
# Số chiều vector. gemini-embedding-001 hỗ trợ 3072, 1536 và 768 theo kiểu
# Matryoshka. Mức 768 nhẹ hơn bốn lần với mức giảm chất lượng không đáng kể.
# Đổi giá trị này buộc phải embed lại toàn bộ corpus.
EMBED_DIM=768
# Trần token cho một request, và là ràng buộc quyết định khi gom lô: 40 chunk có
# thể là 4.000 token nếu toàn summary hoặc 38.000 token nếu toàn body, mà cả lô
# đi trong một lần gọi nên vượt trần TPM là bị từ chối ngay.
EMBED_BATCH_TOKENS=20000
# Trần trên số chunk mỗi lô, chỉ là chặn phụ.
EMBED_BATCH=40

# ---- Cắt chunk (đổi giá trị buộc phải embed lại toàn bộ) -------------------
CHUNK_MAX_TOKENS=1200
CHUNK_SINGLE_TOKENS=1400

# ---- BM25 sparse -----------------------------------------------------------
BM25_K1=1.2
BM25_B=0.75
# Độ dài trung bình của một chunk sau khi tách token, dùng để chuẩn hoá theo độ
# dài. Cần đo lại mỗi khi đổi CHUNK_MAX_TOKENS hoặc CHUNK_SINGLE_TOKENS.
BM25_AVGDL=645
BM25_BIGRAM=1

# ---- Hỏi-đáp ---------------------------------------------------------------
STREAMLIT_PORT=8501
ASK_TOP_K=8
# Sàn cosine thực để kết luận kho có dữ liệu về câu hỏi; đây là cổng thứ nhất
# chống bịa. Hiệu chuẩn trên số mẫu còn ít: nhóm ngoài phạm vi kho đo được
# 0,617 và 0,627, nhóm trong phạm vi đo được 0,771 và 0,817.
ASK_MIN_COSINE=0.70
# Hai bài chênh điểm dưới ngưỡng này coi là ngang nhau, và khi đó bài mới hơn
# đứng trước. Thời gian chỉ phá thế hoà, không hạ điểm bài khớp tốt hơn.
ASK_SCORE_EPS=0.02
# Hệ số lấy dư ở tầng chunk trước khi gộp về bài.
ASK_OVERFETCH=3
# Chế độ sắp theo thời gian cần lấy dư rộng hơn, vì bài mới nhất của kho không
# chắc nằm trong nhóm khớp cao nhất.
ASK_RECENT_OVERFETCH=8
# Giới hạn chờ hạn mức trên đường tương tác: hết thời gian thì báo lỗi rõ ràng
# thay vì để giao diện treo.
ASK_MAX_WAIT=20

# ---- Airflow ---------------------------------------------------------------
AIRFLOW_PORT=8085
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Sinh giá trị mới bằng:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=UKMzEm3yIuFYEq1y3-2FxPNWSVwRASpahmQ9kQfEr8E=
# Sinh giá trị mới bằng:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=9a5f8c2b1e7d4a6f3c0b8e2d5a9f1c4b7e0d3a6f9c2b5e8d1a4f7c0b3e6d9a2f
# UID của user trên host, cần cho quyền ghi vào volume mount trên Linux.
# Giá trị 50000 khớp user mặc định trong image Airflow.
AIRFLOW_UID=50000

# ---- Trino (engine SQL trên Iceberg) ---------------------------------------
TRINO_VERSION=453
TRINO_PORT=8080
