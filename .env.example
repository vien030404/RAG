# ============================================================================
# News Crawler -> RAG  ·  environment configuration
# Copy to `.env` and adjust as needed. `.env` is git-ignored.
# ============================================================================

# ---- Image versions (pin for reproducibility) ------------------------------
POSTGRES_VERSION=16
MINIO_VERSION=RELEASE.2024-08-17T01-24-54Z
MINIO_MC_VERSION=RELEASE.2024-08-17T11-33-50Z
# Apache Iceberg REST catalog fixture (successor to tabular/iceberg-rest)
ICEBERG_REST_VERSION=1.9.2
# PostgreSQL JDBC driver added to the catalog image (see iceberg-rest/Dockerfile)
POSTGRES_JDBC_VERSION=42.7.4
AIRFLOW_VERSION=2.10.2

# ---- Shared Postgres (metadata for Iceberg catalog / Airflow) --------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- MinIO (S3-compatible object storage) ----------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Buckets created on startup
MINIO_WAREHOUSE_BUCKET=warehouse   # Iceberg warehouse (Bronze table data)
MINIO_RAW_BUCKET=raw               # raw zone: gzipped source HTML
AWS_REGION=us-east-1

# ---- Iceberg REST Catalog --------------------------------------------------
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_DB=iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg

# ---- Qdrant (vector store cho RAG) -----------------------------------------
QDRANT_VERSION=v1.12.4
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Qdrant bật auth khi biến này tồn tại — KHÔNG để trống (rỗng = auth bật nhưng
# không key nào hợp lệ). Giá trị dưới đây chỉ dùng cho local development.
QDRANT_API_KEY=qdrant-local-dev
QDRANT_COLLECTION=news_chunks

# ---- Gemini (embedding + sinh câu trả lời) ---------------------------------
# Lấy key tại https://aistudio.google.com/apikey — KHÔNG commit file .env
# Nhieu key, phan tach bang dau phay => xoay vong khi 1 key het quota.
# Quota Gemini tinh theo PROJECT: cac key phai thuoc project khac nhau
# thi moi cong don duoc han muc.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_KEY_COOLDOWN=60
# Ngân sách token/phút cho MỖI key. Trần suy ra từ quan sát, chỉnh được nếu
# Google đổi hạn mức. SAFETY = phần trần thực sự dùng (ước lượng token có thể hụt).
GEMINI_TPM_LIMIT=30000
GEMINI_TPM_SAFETY=0.8
GEMINI_RPM_LIMIT=100
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-latest
# Số chiều vector. gemini-embedding-001 hỗ trợ 3072/1536/768 (Matryoshka).
# 768 = nhẹ hơn 4 lần, chất lượng giảm không đáng kể. Đổi = phải embed lại toàn bộ.
EMBED_DIM=768
# Tran token cho MOT request. Day moi la rang buoc THAT: 40 chunk co the la
# 4k token (toan summary) hoac 38k (toan body) -> vuot tran TPM va 429 ngay.
EMBED_BATCH_TOKENS=20000
# Tran TREN so chunk trong mot lo (chan phu).
EMBED_BATCH=40

# ---- Chunk (doi = phai embed lai TOAN BO) ----------------------------------
CHUNK_MAX_TOKENS=1200
CHUNK_SINGLE_TOKENS=1400

# ---- BM25 sparse -----------------------------------------------------------
BM25_K1=1.2
BM25_B=0.75
# Do lai tren corpus hien tai: mean 534. Gia tri 645 la tu corpus Silver cu.
BM25_AVGDL=645
BM25_BIGRAM=1

# ---- Hoi-dap ---------------------------------------------------------------
# Giao dien hoi-dap Streamlit
STREAMLIT_PORT=8501
ASK_TOP_K=8
# San cosine THAT de coi la "kho co du lieu" (cong 1 chong bia).
# Hieu chuan tren it mau: 0.617/0.627 (khong co) vs 0.771/0.817 (co).
ASK_MIN_COSINE=0.70
# Chenh diem duoi nguong nay = ngang nhau -> bai MOI dung truoc.
ASK_SCORE_EPS=0.02
# Lay du bao nhieu lan o tang chunk truoc khi gop ve bai.
ASK_OVERFETCH=3
ASK_RECENT_OVERFETCH=8
# Duong TUONG TAC: cho quota toi da ngan nay giay roi bao loi, khong treo.
ASK_MAX_WAIT=20

# ---- Airflow ---------------------------------------------------------------
AIRFLOW_PORT=8085
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=UKMzEm3yIuFYEq1y3-2FxPNWSVwRASpahmQ9kQfEr8E=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=9a5f8c2b1e7d4a6f3c0b8e2d5a9f1c4b7e0d3a6f9c2b5e8d1a4f7c0b3e6d9a2f
# Host UID for mounted volume permissions (Linux). 50000 matches the image user.
AIRFLOW_UID=50000

# ---- Trino (SQL engine tren Iceberg) ---------------------------------------
TRINO_VERSION=453
TRINO_PORT=8080
