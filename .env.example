# ============================================================================
# Lakehouse Pipeline - environment configuration
# Copy to `.env` and adjust as needed. `.env` is git-ignored.
# ============================================================================

# ---- Image versions (pin for reproducibility) ------------------------------
POSTGRES_VERSION=16
MINIO_VERSION=RELEASE.2024-08-17T01-24-54Z
MINIO_MC_VERSION=RELEASE.2024-08-17T11-33-50Z
# Apache Iceberg REST catalog fixture (successor to tabular/iceberg-rest)
ICEBERG_REST_VERSION=1.9.2
# PostgreSQL JDBC driver added to the catalog image (see iceberg-rest/Dockerfile)
POSTGRES_JDBC_VERSION=42.7.4
TRINO_VERSION=453
AIRFLOW_VERSION=2.10.2

# ---- Shared Postgres (metadata for Iceberg catalog / Airflow) --------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ---- MinIO (S3-compatible object storage) ----------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket created on startup (Iceberg warehouse; crawler writes straight to Bronze)
MINIO_WAREHOUSE_BUCKET=warehouse
AWS_REGION=us-east-1

# ---- Iceberg REST Catalog --------------------------------------------------
ICEBERG_REST_PORT=8181
ICEBERG_CATALOG_DB=iceberg_catalog
ICEBERG_CATALOG_USER=iceberg
ICEBERG_CATALOG_PASSWORD=iceberg

# ---- Trino -----------------------------------------------------------------
TRINO_PORT=8080

# ---- Airflow ---------------------------------------------------------------
AIRFLOW_PORT=8085
AIRFLOW_DB=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=UKMzEm3yIuFYEq1y3-2FxPNWSVwRASpahmQ9kQfEr8E=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=9a5f8c2b1e7d4a6f3c0b8e2d5a9f1c4b7e0d3a6f9c2b5e8d1a4f7c0b3e6d9a2f
# Host UID for mounted volume permissions (Linux). 50000 matches the image user.
AIRFLOW_UID=50000
